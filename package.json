{
  "name": "studybuddy-ai",
  "version": "1.0.0",
  "description": "A study pack generator built with open-weight AI models for Hacktoberfest 2026",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "postinstall": "npm --prefix client install"
  },
  "keywords": [
    "study-buddy",
    "ai",
    "open-source-ai",
    "open-weight",
    "llama3",
    "qwen",
    "hacktoberfest-2026"
  ],
  "author": "Antigravity Pair Developer",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
