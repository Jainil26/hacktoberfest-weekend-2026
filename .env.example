# StudyBuddy AI - Environment Variables Configuration

# Server Port
PORT=5000

# Open-Weight AI Provider Choice:
# Options: 'huggingface' | 'groq' | 'openrouter' | 'ollama' | 'auto'
AI_PROVIDER=auto

# Option 1: Hugging Face Inference API (Free tier token works great for Qwen 2.5 & Llama 3.3!)
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Option 2: Groq API (Ultra-fast inference for open-weight Llama 3.3 / Qwen)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=

# Option 3: OpenRouter API (Access 100+ open models including DeepSeek R1 & Llama 3.3)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option 4: Local Ollama (No API key required! Must be running locally)
OLLAMA_HOST=http://localhost:11434

# Default Open-Weight Model Name
# Hugging Face: Qwen/Qwen2.5-72B-Instruct or meta-llama/Llama-3.3-70B-Instruct or mistralai/Mistral-7B-Instruct-v0.3
# Groq: llama-3.3-70b-versatile or qwen-2.5-32b
DEFAULT_MODEL=Qwen/Qwen2.5-72B-Instruct
